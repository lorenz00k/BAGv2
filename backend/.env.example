PORT=3000

NODE_ENV=development
LOG_LEVEL=info

# Used by docker compose to create the database user. Must match the password inside DATABASE_URL below.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bag_user:change-me@localhost:5433/bag_database

FRONTEND_URL=http://localhost:3001
RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev