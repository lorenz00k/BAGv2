PORT=3000

NODE_ENV=development
LOG_LEVEL=info

# Used by docker compose to create the database user. Must match the password inside DATABASE_URL below.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bag_user:change-me@localhost:5433/bag_database

FRONTEND_URL=http://localhost:3001
RESEND_API_KEY=re_xxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Number of reverse proxies in front of the server (0 = none, e.g. local dev)
TRUSTED_PROXY_COUNT=0

# Shared rate limit counters. Required when NODE_ENV=production; without it
# every server instance counts on its own. Leave unset for local development.
# REDIS_URL=redis://localhost:6379